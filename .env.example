# Copy to .env and adjust. Nothing here is secret for the local setup;
# a future cloud LLM provider would put its API key here (never in code).
OLLAMA_HOST=http://127.0.0.1:11434
# Where embedding / LLM-response caches are stored.
SECRAG_CACHE_DIR=.cache
# Hugging Face models (reranker, NLI) are cached here by sentence-transformers.
# HF_HOME=.cache/hf
